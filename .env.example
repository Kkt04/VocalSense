# VocalSense Environment Variables

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Backend / API Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
DEBUG=false

# Audio Settings
MAX_AUDIO_SIZE_BYTES=26214400
RETAIN_RAW_AUDIO=false
TEMP_STORAGE_DIR=/tmp/vocalsense/audio

# Speech Recognition (faster-whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5

# Primary Database — MongoDB (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vocalsense

# Speech Emotion Recognition (Deep Learning & Baseline)
EMOTION_MODEL_TYPE=wav2vec2
WAV2VEC2_CHECKPOINT=facebook/wav2vec2-base
HUBERT_CHECKPOINT=facebook/hubert-base-ls960
EMOTION_DEVICE=auto
EMOTION_CONFIDENCE_THRESHOLD=0.35

# Conversational Intelligence (OpenAI-compatible LLM endpoint)
# Supports Google Gemini, Groq, OpenAI, Azure OpenAI, Anthropic (via proxy), and local Ollama
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.85
LLM_TIMEOUT_SECONDS=20.0

# Text-to-Speech
ENABLE_TTS=true

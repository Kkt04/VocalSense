# VocalSense Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Audio Upload Constraints
MAX_AUDIO_SIZE_BYTES=26214400  # 25 MB
ALLOWED_AUDIO_EXTENSIONS=[".wav",".webm",".ogg",".mp3",".m4a",".mp4"]

# Privacy Settings
RETAIN_RAW_AUDIO=false
TEMP_STORAGE_DIR=/tmp/vocalsense/audio
